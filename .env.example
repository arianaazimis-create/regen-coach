# Copy this file to .env.local and fill in the keys. Never commit .env.local.
# Ask the teammate who owns the keys to send them to you privately.

# Mapbox public token. Optional for the data scripts (they fall back to free OSRM routing),
# needed by Stream 3's map. The NEXT_PUBLIC_ prefix lets the browser read it.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Claude API key for coaching tips. Optional: without it, `npm run coach` writes rule-based tips.
ANTHROPIC_API_KEY=
